@model IEnumerable<Student_Wellness_Journal_App.Models.JournalEntry>
@{
    ViewData["Title"] = "My Journal";
}

<h2 class="mb-4">My Journal</h2>

<!-- Motivational Quote of the Day -->
<div class="alert alert-info shadow-sm mb-4">
    <h5 class="mb-2">🌟 Motivational Quote of the Day</h5>
    <blockquote class="blockquote mb-0">
        <p>@ViewData["QuoteOfTheDay"]</p>
    </blockquote>
</div>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">New Entry</a>
</div>

<!-- Mood Trends -->
<div class="card p-3 mb-4 shadow-sm">
    <h4 class="mb-3">Mood Trends (Last 30 Days)</h4>
    <div style="height:400px; width:100%;">
        <canvas id="moodChart"></canvas>
    </div>
</div>

<!-- Donut Chart -->
<div class="card p-3 mb-4 shadow-sm">
    <h4 class="mb-3">Overall Mood Distribution (Last 30 Days)</h4>
    <div style="height:350px; width:100%; max-width:500px; margin:auto;">
        <canvas id="moodDonut"></canvas>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>Mood</th>
            <th>Content</th>
            <th style="width: 150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td>@e.Mood</td>
                <td>@Html.Raw(Html.Encode(e.Content).Replace("\n", "<br/>"))</td>
                <td>
                    <a class="btn btn-sm btn-warning me-2"
                       asp-controller="Journal"
                       asp-action="Edit"
                       asp-route-id="@e.Id">Edit</a>
                    <form asp-controller="Journal"
                          asp-action="Delete"
                          asp-route-id="@e.Id"
                          method="post"
                          style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to delete this entry?');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        fetch('@Url.Action("MoodData", "Journal")?days=30')
            .then(r => r.json())
            .then(data => {
                const labels = data.map(d =>
                    new Date(d.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })
                );

                // 🎯 Mood scoring system
                const moodWeights = { Happy: 5, Calm: 4, Neutral: 3, Anxious: 2, Sad: 1, Angry: 0 };

                // Compute average score per day
                const avgScores = data.map(d => {
                    const totalMoods =
                        d.countHappy + d.countNeutral + d.countSad +
                        d.countAngry + d.countAnxious + d.countCalm;

                    const weightedSum =
                        (d.countHappy * moodWeights.Happy) +
                        (d.countCalm * moodWeights.Calm) +
                        (d.countNeutral * moodWeights.Neutral) +
                        (d.countAnxious * moodWeights.Anxious) +
                        (d.countSad * moodWeights.Sad) +
                        (d.countAngry * moodWeights.Angry);

                    return totalMoods > 0 ? (weightedSum / totalMoods) : null;
                });

                // 📊 Stacked Bar + 📈 Line Chart
                const chartData = {
                    labels: labels,
                    datasets: [
                        { label: 'Happy', data: data.map(d => d.countHappy), backgroundColor: 'rgba(255, 206, 86, 0.7)', stack: 'mood' },
                        { label: 'Neutral', data: data.map(d => d.countNeutral), backgroundColor: 'rgba(201, 203, 207, 0.7)', stack: 'mood' },
                        { label: 'Sad', data: data.map(d => d.countSad), backgroundColor: 'rgba(54, 162, 235, 0.7)', stack: 'mood' },
                        { label: 'Angry', data: data.map(d => d.countAngry), backgroundColor: 'rgba(255, 99, 132, 0.7)', stack: 'mood' },
                        { label: 'Anxious', data: data.map(d => d.countAnxious), backgroundColor: 'rgba(153, 102, 255, 0.7)', stack: 'mood' },
                        { label: 'Calm', data: data.map(d => d.countCalm), backgroundColor: 'rgba(75, 192, 192, 0.7)', stack: 'mood' },
                        {
                            label: 'Avg Mood Score',
                            data: avgScores,
                            type: 'line',
                            yAxisID: 'y1',
                            borderColor: 'rgba(0, 0, 0, 0.8)',
                            backgroundColor: 'rgba(0, 0, 0, 0.3)',
                            tension: 0.3,
                            borderWidth: 2,
                            fill: false
                        }
                    ]
                };

                const ctx = document.getElementById('moodChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: chartData,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } },
                        scales: {
                            x: { stacked: true },
                            y: { beginAtZero: true, stacked: true },
                            y1: {
                                beginAtZero: true,
                                min: 0,
                                max: 5,
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                title: { display: true, text: 'Avg Mood Score' }
                            }
                        }
                    }
                });

                // 🍩 Donut Chart (same as before)
                const totalCounts = {
                    happy: data.reduce((a, b) => a + b.countHappy, 0),
                    neutral: data.reduce((a, b) => a + b.countNeutral, 0),
                    sad: data.reduce((a, b) => a + b.countSad, 0),
                    angry: data.reduce((a, b) => a + b.countAngry, 0),
                    anxious: data.reduce((a, b) => a + b.countAnxious, 0),
                    calm: data.reduce((a, b) => a + b.countCalm, 0)
                };

                const donutData = {
                    labels: ['Happy', 'Neutral', 'Sad', 'Angry', 'Anxious', 'Calm'],
                    datasets: [{
                        data: [
                            totalCounts.happy,
                            totalCounts.neutral,
                            totalCounts.sad,
                            totalCounts.angry,
                            totalCounts.anxious,
                            totalCounts.calm
                        ],
                        backgroundColor: [
                            'rgba(255, 206, 86, 0.7)',
                            'rgba(201, 203, 207, 0.7)',
                            'rgba(54, 162, 235, 0.7)',
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(153, 102, 255, 0.7)',
                            'rgba(75, 192, 192, 0.7)'
                        ],
                        borderWidth: 1
                    }]
                };

                const donutCtx = document.getElementById('moodDonut').getContext('2d');
                new Chart(donutCtx, {
                    type: 'doughnut',
                    data: donutData,
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            });
    </script>
}